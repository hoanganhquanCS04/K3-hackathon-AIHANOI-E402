# =============================================================================
# Hybrid RAG & Summarization System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# OpenAI (Primary)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Optional - for Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Optional)
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-pro

# -----------------------------------------------------------------------------
# Qdrant Cloud Configuration
# -----------------------------------------------------------------------------
QDRANT_HOST=xxx-xxx-xxx-xxx.qdrant.tech
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant-...

# Collection names
QDRANT_CHILD_CHUNKS_COLLECTION=transcript_child_chunks
QDRANT_PARENT_CHUNKS_COLLECTION=transcript_parent_chunks

# Vector dimensions (adjust based on embedding model)
QDRANT_VECTOR_DIM=1536  # text-embedding-3-small
# QDRANT_VECTOR_DIM=3072  # text-embedding-3-large

# -----------------------------------------------------------------------------
# Neo4j AuraDB Configuration
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Chunking configuration
PARENT_CHUNK_SIZE=5  # Number of child turns per parent chunk

# Retrieval settings
DEFAULT_TOP_K=5
MAX_RETRIEVAL_RESULTS=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Paths
DATA_DIR=data
CACHE_DIR=data/cache
